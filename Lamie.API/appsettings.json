{
  "Jwt": {
    "Issuer": "Lamie.API",
    "Audience": "Lamie.Admin",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "BootstrapAdmin": {
    "Email": "",
    "UserName": "",
    "Password": "",
    "FullName": "System administrator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "http://localhost:3000",
      "https://localhost:5173",
      "http://localhost:5173",
      "http://localhost:8002"
    ]
  },
  "LocalStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicBasePath": "/uploads"
  },
  "FeDataExport": {
    "AllowedRoot": "../../FE_Lamie/public",
    "TargetDirectory": "../../FE_Lamie/public/fe-data"
  },
  "ProductRecognition": {
    "MinimumSimilarity": 0.62,
    "BackfillBatchSize": 40
  },
  "OpenAIContent": {
    "Endpoint": "https://api.openai.com/v1/responses",
    "Model": "gpt-5.6",
    "PromptVersion": "lamie-social-content-v1",
    "TimeoutSeconds": 60,
    "MaximumRetries": 2,
    "MaximumImages": 4,
    "MaximumImageBytes": 10485760
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "AdministrativeData": {
    "ImportOnStartup": false,
    "RootPath": "Data/AdministrativeUnits"
  },
  "AdministrativeAddressResolution": {
    "DefaultProvinceCode": "79",
    "CandidateLimit": 8,
    "ConfidentThreshold": 0.82
  },
  "ChatScreenshotAnalysis": {
    "Enabled": true,
    "TessdataPath": "Data/Tessdata",
    "TesseractExecutablePath": "tesseract",
    "MaximumFiles": 10,
    "MaximumFileBytes": 10485760,
    "MaximumImagePixels": 30000000,
    "MaximumImageDimension": 16384,
    "MaximumImageAspectRatio": 8,
    "MaximumWorkingImagePixels": 8000000,
    "MaximumWorkingImageDimension": 4096,
    "OcrTimeoutSeconds": 20,
    "PlatformSignalTargetWidth": 1800,
    "HeaderTargetWidth": 2200,
    "PlatformMinimumScore": 0.48,
    "PlatformMinimumMargin": 0.14
  },
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=Lamie;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Command Timeout=30"
  }
}
